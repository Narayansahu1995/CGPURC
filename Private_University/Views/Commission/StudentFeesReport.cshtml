@model IEnumerable<Private_University.Models.UniversityWorkDetail>

@{
    ViewBag.Title = "WorkReport";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var months = ViewBag.Months as List<string> ?? new List<string>();
}

<div class="sb2-2-3">
    <div class="row">
        <div class="col-md-12">
            <div class="box-inn-sp admin-form">
                <div class="inn-title d-flex justify-content-between align-items-center">
                    <h4>University 1% Fees Details </h4>
                   
                </div>
               
                <div class="tab-inn">
                    <button id="btnExportExcel" class="btn btn-success">
                        <i class="fa fa-file-excel"></i> Export to Excel
                    </button>
                    <div class="table-responsive">
                        <table class="table table-bordered text-center table-striped" id="Flist">
                            <thead class="table-light" style="background-color: lightgoldenrodyellow;">
                                <tr>
                                    <th>S.No.</th>
                                    <th>University Name</th>
                                    @foreach (var month in months)
                                    {
                                        <th>@month</th>
                                    }
                                    <th>Total</th>
                                </tr>
                            </thead>

                            <tbody>
                                @{
                                    int sno = 1;
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@sno</td>
                                            <td class="text-start">@item.UniversityName</td>

                                            @foreach (var month in months)
                                            {
                                                decimal amount = 0;
                                                if (item.MonthWiseAmounts != null &&
                                                    item.MonthWiseAmounts.ContainsKey(month))
                                                {
                                                    amount = item.MonthWiseAmounts[month];
                                                }

                                                <td class="text-end">
                                                    @(amount == 0 ? "-" : amount.ToString())
                                                </td>
                                            }

                                            <td class="text-end fw-bold">
                                                @(item.MonthWiseAmounts != null && item.MonthWiseAmounts.ContainsKey("Total")
                                                    ? item.MonthWiseAmounts["Total"].ToString()
                                                    : "₹0")
                                            </td>
                                        </tr>
                                        sno++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SheetJS library -->
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<script>
document.getElementById("btnExportExcel").addEventListener("click", function () {
    var table = document.getElementById("Flist");

    // Create workbook
    var wb = XLSX.utils.book_new();

    // Convert HTML table to worksheet
    var ws = XLSX.utils.table_to_sheet(table, { raw: true });

    // Convert any "-" cells to 0 (numeric)
    var range = XLSX.utils.decode_range(ws['!ref']);
    for (var R = range.s.r + 1; R <= range.e.r; ++R) { // skip header row
        for (var C = 2; C <= range.e.c; ++C) { // skip S.No. and University Name
            var cell_address = { c: C, r: R };
            var cell_ref = XLSX.utils.encode_cell(cell_address);
            if (ws[cell_ref] && ws[cell_ref].v === "-") {
                ws[cell_ref].v = 0;
                ws[cell_ref].t = "n"; // numeric type
            }
        }
    }

    // Add worksheet to workbook
    XLSX.utils.book_append_sheet(wb, ws, "University Fees");

    // Download Excel
    XLSX.writeFile(wb, "UniversityFeesReport.xlsx");
});
</script>
