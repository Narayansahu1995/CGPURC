@model IEnumerable<Private_University.Models.UniversityWorkDetail>

@{
    ViewBag.Title = "WorkReport";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    // Example: Pass dynamic months list from controller via ViewBag or Model
    var months = ViewBag.Months as List<string>;
    // months = ["Jan-2025", "Feb-2025", "Mar-2025", ...]
}

<div class="sb2-2-3">
    <div class="row">
        <div class="col-md-12">
            <div class="box-inn-sp admin-form">
                <div class="inn-title">
                    <h4>University 1% Fees Details</h4>
                </div>
                <div class="tab-inn">
                    <table class="table table-bordered text-center" id="Flist">
                        <thead style="background-color: lightgoldenrodyellow;">
                            <tr>
                                <th style="font-weight:bold;">SNo.</th>
                                <th style="font-weight:bold;">University Name</th>
                                @foreach (var month in months)
                                {
                                    <th style="font-weight:bold;">@month</th>
                                }
                                <th style="font-weight:bold;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sno = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@sno</td>
                                        <td>@item.UniversityName</td>
                                        @foreach (var month in months)
                                        {
                                            // Assuming you have Dictionary<string, decimal> in model
                                            // where Key = "Jan-2025" and Value = amount
                                            var amount = item.MonthWiseAmounts.ContainsKey(month) ? item.MonthWiseAmounts[month] : 0;
                                            <td>@amount</td>
                                        }
                                        <td style="font-weight:bold;">@item.MonthWiseAmounts.Values.Sum()</td>
                                    </tr>
                                    sno++;
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" style="font-weight:bold; text-align:center;">Total :-</td>
                                @foreach (var month in months)
                                {
                                    <td style="font-weight:bold;">
                                        @Model.Sum(m => m.MonthWiseAmounts.ContainsKey(month) ? m.MonthWiseAmounts[month] : 0)
                                    </td>
                                }
                                <td style="font-weight:bold;">
                                    @Model.Sum(m => m.MonthWiseAmounts.Values.Sum())
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
