@model IEnumerable<Private_University.Models.UniversityWorkDetail>

@{
    ViewBag.Title = "StudentEnrolledReport";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    int sessionId = ViewBag.SessionID ?? 0;
    string reportTitle = "Student Enrolled Report";

    if (sessionId == 6)
    {
        reportTitle += " - 2025-26";
    }
    else if (sessionId == 5)
    {
        reportTitle += " - 2024-25";
    }
    else if (sessionId == 4)
    {
        reportTitle += " - 2023-24";
    }
    else if (sessionId == 3)
    {
        reportTitle += " - 2022-23";
    }
}

<div class="sb2-2-3">
    <div class="row">
        <div class="col-md-12">
            <div class="box-inn-sp admin-form">
                <div class="inn-title">
                    <h4>@reportTitle</h4>
                </div>

                <div class="tab-inn">
                    <!-- ✅ Export Button -->
                    <div style="text-align:right; margin-bottom:10px;">
                        <button id="btnExport" class="btn btn-success">
                            <i class="fa fa-file-excel-o"></i> Export to Excel
                        </button>
                    </div>

                    <!-- ✅ Data Table -->
                    <table class="table table-bordered" style="width:auto;margin:auto;" id="Flist">
                        <thead style="background-color: lightgoldenrodyellow;">
                            <tr>
                                <th style="font-weight:bold;">SNo.</th>
                                <th style="font-weight:bold;">University Name</th>
                                <th style="font-weight:bold;">No.Of Students</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.count)</td>
                                    <td>@Html.DisplayFor(modelItem => item.UniversityName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.NoOfStudents)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" style="font-weight:bold; text-align:center;">Total :-</td>
                                <td style="font-weight:bold;">@Model.Sum(m => m.NoOfStudents)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden field to pass sessionId to JS -->
<input type="hidden" id="sessionId" value="@sessionId" />

<!-- ✅ Excel Export Script -->
<script>
document.getElementById("btnExport").addEventListener("click", function () {
    var table = document.getElementById("Flist");
    var tableClone = table.cloneNode(true);
    var sessionId = document.getElementById("sessionId").value;

    // Decide report title
    var reportTitle = "Student Enrolled Report";
    if (sessionId == "6") {
        reportTitle += " - 2025-26";
    } else if (sessionId == "5") {
        reportTitle += " - 2024-25";
    }
    else if (sessionId == "4") {
        reportTitle += " - 2023-24";
    }
    else if (sessionId == "3") {
        reportTitle += " - 2022-23";
    }
    // Add title row
    var headerRow = document.createElement("tr");
    var headerCell = document.createElement("th");
    headerCell.colSpan = 3;
    headerCell.style.textAlign = "center";
    headerCell.style.fontSize = "16px";
    headerCell.style.fontWeight = "bold";
    headerCell.style.backgroundColor = "#f2f2f2";
    headerCell.textContent = reportTitle;
    headerRow.appendChild(headerCell);

    tableClone.querySelector("thead").insertBefore(headerRow, tableClone.querySelector("thead").firstChild);

    // Add styling for Excel
    var style = `
        <style>
            table, th, td {
                border: 1px solid #555;
                border-collapse: collapse;
                padding: 5px;
                text-align: center;
            }
            th {
                background-color: lightgoldenrodyellow;
                font-weight: bold;
            }
            tfoot td {
                font-weight: bold;
            }
        </style>
    `;

    // Combine table and style
    var html = style + tableClone.outerHTML;

    // Trigger download
    var fileName = 'StudentEnrolledReport.xls';
    var link = document.createElement('a');
    link.href = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
    link.download = fileName;
    link.click();
});
</script>
